---
if (!import.meta.env.DEV) return new Response(null, { status: 404 });
import PublicLayout from "@/layouts/PublicLayout.astro";
import WhatsAppButton from "@/components/public/WhatsAppButton.astro";

const swatches = [
  ["bg", "#FBFCF8"], ["surface", "#FFFFFF"], ["ink", "#0D2B22"], ["ink-2", "#3F564D"],
  ["line", "#D9E2D8"], ["forest", "var(--color-forest)"], ["forest-2", "var(--color-forest-2)"],
  ["lime", "var(--color-lime)"], ["lime-2", "var(--color-lime-2)"], ["mint", "#E4F0E2"], ["tint", "#EEF6DF"],
];
---
<PublicLayout title="دليل الأنماط" noindex>
  <div class="wrap sec" style="padding-top:140px;overflow-x:clip">
    <p class="eyebrow">دليل الأنماط (للتطوير فقط)</p>
    <h1 class="h1" data-split="blur">رعاية صحية <em>لكل الأسرة</em></h1>
    <p class="lead">هذا نص تمهيدي تجريبي لاختبار الخط العربي والاتجاه من اليمين إلى اليسار وارتفاع السطر. رقم الهاتف: <bdi dir="ltr">+963 944 000 000</bdi></p>

    <h2 class="h2">الألوان</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:12px;margin-block:24px">
      {swatches.map(([name, color]) => (
        <div>
          <div style={`background:${color};height:64px;border-radius:12px;border:1px solid var(--color-line)`}></div>
          <small dir="ltr">{name}</small>
        </div>
      ))}
    </div>

    <h2 class="h2">العناوين والنص</h2>
    <p>نص الفقرة العادي: يقدّم هذا الموقع معلومات عن العيادة والخدمات وأوقات الدوام. رسالة واتساب لا تعني تأكيد الموعد.</p>

    <h2 class="h2">الأزرار</h2>
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-block:24px">
      <a class="btn" href="#">احجز عبر واتساب</a>
      <a class="btn btn-ghost" href="#">اعرف المزيد</a>
      <a class="btn btn-sm" href="#">زر صغير</a>
      <a class="btn btn-ghost btn-sm" href="#">زر صغير شفاف</a>
      <WhatsAppButton />
      <WhatsAppButton variant="ghost" />
      <WhatsAppButton size="sm" label="واتساب (صغير)" />
    </div>
    <div class="dark" style="padding:32px;display:flex;gap:12px;flex-wrap:wrap;align-items:center">
      <span class="eyebrow">على خلفية داكنة</span>
      <h2 class="h2" style="margin:0 12px">عنوان <em>مميز</em></h2>
      <a class="btn" href="#">احجز عبر واتساب</a>
      <a class="btn btn-ghost" href="#">اعرف المزيد</a>
      <WhatsAppButton variant="ghost" size="sm" />
    </div>

    <h2 class="h2">الوسوم والبطاقات</h2>
    <ul class="tags" style="margin-block:16px"><li>طب الأسرة</li><li>فحص دوري</li><li>تحاليل</li></ul>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr));gap:20px;margin-block:24px">
      <article class="card">
        <div class="ph"><img src="/img/gp.webp" alt="كشف عام" width="800" height="550" loading="lazy" /></div>
        <div style="padding:20px 14px 10px"><h3>الكشف العام</h3><p>فحص وتشخيص الحالات الشائعة.</p></div>
      </article>
      <div class="ph" style="aspect-ratio:16/11;border-radius:18px;border:1px solid var(--color-line)"></div>
    </div>

    <h2 class="h2">الأرقام المتحركة</h2>
    <p class="h1" style="margin-block:16px"><span data-count="25">25</span>+ <small style="font-size:.4em">سنة خبرة (مثال)</small></p>

    <h2 class="h2" data-split="blur">عنوان بظهور تدريجي</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(200px,100%),1fr));gap:16px;margin-block:24px">
      <div class="card rv" style="--d:0;padding:24px">صندوق ١</div>
      <div class="card rv" style="--d:1;padding:24px">صندوق ٢</div>
      <div class="card rv" style="--d:2;padding:24px">صندوق ٣</div>
    </div>

    <h2 class="h2">زر بحركة اللف (A5)</h2>
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-block:24px">
      <a class="btn" href="#"><span class="roll"><span data-t="احجز عبر واتساب">احجز عبر واتساب</span></span></a>
      <a class="btn btn-ghost" href="#"><span class="roll"><span data-t="اعرف المزيد">اعرف المزيد</span></span></a>
      <p class="lead" style="margin:0;align-self:center">مرّر المؤشر فوق الزر. المخطط المنسدل (A6): مرّر فوق «الخدمات» في الهيدر.</p>
    </div>

    <h2 class="h2">الشارة النابضة (A11)</h2>
    <p style="display:inline-flex;align-items:center;gap:14px;padding:10px 18px;border-radius:999px;background:var(--color-mint);margin-block:16px">
      <span class="pulse"></span> عيادة خاصة (مثال)
    </p>

    <h2 class="h2">صورة بتأثير المنظور (A12)</h2>
    <div class="ph" style="aspect-ratio:16/7;border-radius:var(--radius-media);margin-block:24px">
      <img data-par="0.12" src="/img/hero.webp" alt="" width="1600" height="1067" style="position:absolute;inset:-12% 0;height:124%;object-fit:cover" loading="lazy" />
    </div>

    <h2 class="h2">تأثير الصورة الرئيسية (A10)</h2>
    <div class="ph hero-media" data-hero style="max-width:420px;margin-block:24px">
      <div class="zoom"><img src="/img/hero.webp" alt="" width="1600" height="1067" loading="lazy" /></div>
    </div>

    <section class="dark" style="padding:clamp(40px,6vw,80px) 0;margin-block:24px;overflow:hidden">
      <div class="wrap">
        <p class="eyebrow">الخطوط المنجرفة (A13) وإضاءة الكلمات (A14)</p>
        <div class="big" aria-hidden="true">
          <span class="ln" data-drift="-1">رعاية تبدأ</span>
          <span class="ln l2" data-drift="1">بالإصغاء</span>
        </div>
        <p class="fill" data-fill style="margin-top:40px;max-width:28em">نؤمن بأن الرعاية الجيدة تبدأ بالإصغاء وتنتهي بخطة واضحة تفهمها ويمكنك الالتزام بها، وهذا نص تجريبي لاختبار إضاءة الكلمات أثناء التمرير.</p>
      </div>
    </section>

    <h2 class="h2">الشريط المتحرك (A18)</h2>
  </div>
  <div class="band" aria-hidden="true" style="margin-block:24px">
    <div class="track">
      {[0, 1].map(() => (
        <span>
          طب الأسرة <svg viewBox="0 0 32 32" fill="currentColor"><path d="M16 15c-3-2.8-3-7.6 0-10.6 3 3 3 7.8 0 10.6zM16 17c3 2.8 3 7.6 0 10.6-3-3-3-7.8 0-10.6zM15 16c-2.8 3-7.6 3-10.6 0 3-3 7.8-3 10.6 0zM17 16c2.8-3 7.6-3 10.6 0-3 3-7.8 3-10.6 0z" /></svg>
          فحص دوري <svg viewBox="0 0 32 32" fill="currentColor"><path d="M16 15c-3-2.8-3-7.6 0-10.6 3 3 3 7.8 0 10.6zM16 17c3 2.8 3 7.6 0 10.6-3-3-3-7.8 0-10.6zM15 16c-2.8 3-7.6 3-10.6 0 3-3 7.8-3 10.6 0zM17 16c2.8-3 7.6-3 10.6 0-3 3-7.8 3-10.6 0z" /></svg>
          تحاليل <svg viewBox="0 0 32 32" fill="currentColor"><path d="M16 15c-3-2.8-3-7.6 0-10.6 3 3 3 7.8 0 10.6zM16 17c3 2.8 3 7.6 0 10.6-3-3-3-7.8 0-10.6zM15 16c-2.8 3-7.6 3-10.6 0 3-3 7.8-3 10.6 0zM17 16c2.8-3 7.6-3 10.6 0-3 3-7.8 3-10.6 0z" /></svg>
        </span>
      ))}
    </div>
  </div>
  <div class="wrap" style="overflow-x:clip">
    <h2 class="h2">كشف البطاقة (A19)</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(200px,100%),1fr));gap:20px;margin-block:24px">
      {[0, 1, 2].map((d) => (
        <div class="doc rv" style={`--d:${d}`}>
          <div class="clip ph" style={`--d:${d};aspect-ratio:4/5;border-radius:22px`}>
            <img src={["/img/doc-aoki.webp", "/img/doc-ellison.webp", "/img/doc-okafor.webp"][d]} alt="صورة تجريبية" width="800" height="1000" loading="lazy" />
          </div>
        </div>
      ))}
    </div>

    <section id="how" data-steps style="margin-block:48px">
      <h2 class="h2">الخطوات الثابتة (A17)</h2>
      <div class="steps-grid" style="margin-top:32px">
        <div class="steps-media">
          {["/img/reception.webp", "/img/checkup.webp", "/img/lab.webp", "/img/specialist.webp"].map((src, k) => (
            <div class={k === 0 ? "ph on" : "ph"} data-shot={k}><img src={src} alt="" width="1600" height="1067" loading="lazy" /></div>
          ))}
          <div class="steps-count" aria-hidden="true"><span data-vnum>01</span><small>/ 04</small></div>
        </div>
        <div class="steps-list">
          {[
            ["راسلنا على واتساب", "أرسل رسالة قصيرة تذكر فيها سبب الزيارة."],
            ["نتواصل معك", "يرد فريق العيادة ويقترح عليك الأوقات المتاحة."],
            ["تأكيد الموعد", "لا يُعدّ الموعد مؤكدًا إلا بعد تأكيد العيادة."],
            ["تزورنا", "نستقبلك في العيادة ونبدأ بالكشف."],
          ].map(([title, text], k) => (
            <article class={k === 0 ? "steps-item on" : "steps-item"} data-step={k}>
              <span class="steps-n">0{k + 1}</span>
              <h3>{title}</h3>
              <p>{text}</p>
              <div class="ph"><img src={["/img/reception.webp", "/img/checkup.webp", "/img/lab.webp", "/img/specialist.webp"][k]} alt="" width="1600" height="1067" loading="lazy" /></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <div style="height:20vh" aria-hidden="true"></div>
    <div class="card rv" style="padding:24px">صندوق يظهر عند التمرير</div>
  </div>
</PublicLayout>
