---
if (!import.meta.env.DEV) return new Response(null, { status: 404 });
import Base from "../../layouts/Base.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import SectionHero from "../../components/SectionHero.astro";
import SectionBold from "../../components/SectionBold.astro";
import SectionServices from "../../components/SectionServices.astro";
import SectionVisit from "../../components/SectionVisit.astro";
import SectionBand from "../../components/SectionBand.astro";
import SectionDoctors from "../../components/SectionDoctors.astro";
import SectionPrices from "../../components/SectionPrices.astro";
import SectionReviews from "../../components/SectionReviews.astro";
import SectionFaq from "../../components/SectionFaq.astro";
import SectionBook from "../../components/SectionBook.astro";
import SectionFooter from "../../components/SectionFooter.astro";
---
<Base>
<SectionHeader />
<main id="main">
<SectionHero />
<SectionBold />
<SectionServices />
<SectionVisit />
<SectionBand />
<SectionDoctors />
<SectionPrices />
<SectionReviews />
<SectionFaq />
<SectionBook />
</main>
<SectionFooter />
<a href="/dev/styleguide" style="position:fixed;inset-inline-end:16px;bottom:16px;z-index:200;padding:12px 18px;border-radius:999px;background:#0D2B22;color:#fff;font:600 14px/1 system-ui,sans-serif;text-decoration:none;box-shadow:0 10px 30px -10px rgba(0,0,0,.5)">&larr; Back to the new Arabic site</a>
</Base>
