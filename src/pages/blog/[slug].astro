---
import PublicLayout from "@/layouts/PublicLayout.astro";
import BookingNotice from "@/components/public/BookingNotice.astro";
import WhatsAppButton from "@/components/public/WhatsAppButton.astro";
import { getPublishedArticleBySlug } from "@/lib/data";
import { sanitizeArticleHtml } from "@/lib/sanitize";

// A missing slug and a draft both answer 404.
const article = await getPublishedArticleBySlug(Astro.params.slug ?? "");
if (!article) return new Response("Not found", { status: 404 });

const dateFmt = new Intl.DateTimeFormat("ar", { dateStyle: "long" });
const title = article.seo_title || article.title;
const description = article.seo_description || article.excerpt || undefined;
// The share image: a real http(s) URL or a local path; never a data URL.
const img = article.featured_image;
const ogImage = img && (/^https?:\/\//.test(img) || img.startsWith("/")) ? img : undefined;
// Sanitized again on render, even though it was sanitized when saved.
const html = sanitizeArticleHtml(article.content);
---
<PublicLayout title={title} description={description} ogImage={ogImage}>
  <article class="sec" style="padding-top:clamp(120px,14vw,170px)">
    <div class="wrap article-wrap">
      <nav class="crumbs" aria-label="مسار التنقل"><a href="/blog">← كل المقالات</a></nav>
      {article.featured_image && (
        <div class="ph article-hero"><img src={article.featured_image} alt="" width="1600" height="900" /></div>
      )}
      <h1 class="h2" style="margin-top:28px">{article.title}</h1>
      {article.published_at && <p class="article-date"><time datetime={article.published_at}>{dateFmt.format(new Date(article.published_at))}</time></p>}
      <div class="prose-ar" set:html={html}></div>
      <div class="article-end">
        <WhatsAppButton />
        <BookingNotice />
      </div>
    </div>
  </article>
</PublicLayout>
