---
import BookingNotice from "@/components/public/BookingNotice.astro";
import ContactCtaCard from "@/components/public/ContactCtaCard.astro";
import { doctorConfig } from "@/config";
import PublicLayout from "@/layouts/PublicLayout.astro";
import { getProfile, getSeoSetting } from "@/lib/data";
import { waLink } from "@/lib/whatsapp";
import SocialIcon from "@/components/public/SocialIcon.astro";
import { SOCIAL_NAMES } from "@/lib/services";

const [profile, seo] = await Promise.all([getProfile(), getSeoSetting("contact")]);
const name = `${profile.honorific} ${profile.full_name}`;
const title = seo?.seo_title || `تواصل | ${name}`;
const description = seo?.seo_description || doctorConfig.site.defaultDescription;
const ogImage = seo?.og_image || undefined;
---
<PublicLayout title={title} description={description} ogImage={ogImage}>
  <section class="sec" style="padding-top:clamp(120px,14vw,170px)" aria-labelledby="contact-h">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">تواصل</span>
          <h1 class="h2" id="contact-h" data-split>تواصل <em>معنا</em></h1>
        </div>
        <p class="lead rv">أسرع طريقة للحجز أو الاستفسار هي رسالة واتساب. اختر ما يناسبك من الطرق أدناه.</p>
      </div>

      <div class="book-grid" style="padding:0">
        <div class="book-l">
          <dl class="info">
            {profile.phone && (
              <div><dt>الهاتف</dt><dd><a href={`tel:${profile.phone.replace(/[^\d+]/g, "")}`}><bdi dir="ltr">{profile.phone}</bdi></a></dd></div>
            )}
            <div><dt>واتساب</dt><dd><a href={waLink(profile.whatsapp, profile.whatsapp_default_message)} target="_blank" rel="noopener"><bdi dir="ltr">+{profile.whatsapp}</bdi></a></dd></div>
            {profile.email && (
              <div><dt>البريد</dt><dd><a href={`mailto:${profile.email}`}><bdi dir="ltr">{profile.email}</bdi></a></dd></div>
            )}
            {profile.socials.length > 0 && (
              <div>
                <dt>حساباتنا</dt>
                <dd>
                  <ul class="social-links">
                    {profile.socials.map((s) => (
                      <li><a href={s.url} target="_blank" rel="noopener" aria-label={SOCIAL_NAMES[s.platform] ?? s.platform}><SocialIcon platform={s.platform} /></a></li>
                    ))}
                  </ul>
                </dd>
              </div>
            )}
          </dl>
        </div>
        <ContactCtaCard profile={profile} />
      </div>

      <p class="lead" style="margin-top:28px"><a href="/#clinics">مواعيد العيادات وأماكنها</a></p>
      <div style="margin-top:20px"><BookingNotice /></div>
    </div>
  </section>
</PublicLayout>
