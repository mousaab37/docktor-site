---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import ServiceForm from "@/components/dashboard/ServiceForm.astro";
import { getRepo } from "@/lib/repo";
import { applyImageChange } from "@/lib/dashboard/images";
import { serviceInput } from "@/lib/validation/service";
import { parseForm, type FormValues } from "@/lib/validation/form";

const repo = getRepo();
const row = await repo.services.get(Astro.params.id ?? "");
if (!row) return new Response("Not found", { status: 404 });

let values: FormValues = {
  title: row.title,
  description: row.description,
  is_active: row.is_active,
};
let errors: Record<string, string> = {};

if (Astro.request.method === "POST") {
  const fd = await Astro.request.formData();
  const result = parseForm(serviceInput, fd);
  if (result.ok) {
    // The current image comes from the stored row, never from the form.
    // task 17: own bucket for service images
    const image = await applyImageChange(repo, "certificates", fd, "image", row.image_path);
    if (!image.error) {
      await repo.services.update(row.id, { ...result.data, image_path: image.path });
      if (image.oldToRemove) await repo.images.remove("certificates", image.oldToRemove);
      return Astro.redirect("/dashboard/services?ok=saved", 303);
    }
    values = result.values;
    errors = { image: image.error };
  } else {
    values = result.values;
    errors = result.errors;
  }
  Astro.response.status = 422;
}
---
<DashboardLayout title="تعديل خدمة">
  <ServiceForm values={values} errors={errors} currentImage={row.image_path} cancelHref="/dashboard/services" />
</DashboardLayout>
