---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import ServiceForm from "@/components/dashboard/ServiceForm.astro";
import { getDashboardRepo } from "@/lib/repo";
import { applyImageChange } from "@/lib/dashboard/images";
import { serviceInput } from "@/lib/validation/service";
import { parseForm, type FormValues } from "@/lib/validation/form";

const repo = getDashboardRepo(Astro.locals);
let values: FormValues = { title: "", description: "", is_active: true, is_featured: false };
let errors: Record<string, string> = {};

if (Astro.request.method === "POST") {
  const fd = await Astro.request.formData();
  const result = parseForm(serviceInput, fd);
  if (result.ok) {
    // Validate first, upload second, so a refused form never leaves an orphan file.
    const image = await applyImageChange(repo, "services", fd, "image", null);
    if (!image.error) {
      await repo.services.create({ ...result.data, image_path: image.path });
      return Astro.redirect("/dashboard/services?ok=saved", 303);
    }
    values = result.values;
    errors = { image: image.error };
  } else {
    values = result.values;
    errors = result.errors;
  }
  Astro.response.status = 422;
}
---
<DashboardLayout title="إضافة خدمة">
  <ServiceForm values={values} errors={errors} cancelHref="/dashboard/services" />
</DashboardLayout>
