---
import { doctorConfig } from "@/config";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import ClinicForm from "@/components/dashboard/ClinicForm.astro";
import { getRepo } from "@/lib/repo";
import { clinicFormValues, parseClinicForm } from "@/lib/validation/clinic";
import type { FormValues } from "@/lib/validation/form";

let values: FormValues = clinicFormValues(null, doctorConfig.contact.defaultCountry);
let errors: Record<string, string> = {};

if (Astro.request.method === "POST") {
  const result = parseClinicForm(await Astro.request.formData());
  if (result.ok) {
    await getRepo().clinics.create(result.data);
    return Astro.redirect("/dashboard/clinics?ok=saved", 303);
  }
  values = result.values;
  errors = result.errors;
  Astro.response.status = 422;
}
---
<DashboardLayout title="إضافة عيادة">
  <ClinicForm values={values} errors={errors} cancelHref="/dashboard/clinics" />
</DashboardLayout>
