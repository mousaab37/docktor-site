---
import { doctorConfig } from "@/config";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import ClinicForm from "@/components/dashboard/ClinicForm.astro";
import { getRepo } from "@/lib/repo";
import { clinicFormValues, parseClinicForm } from "@/lib/validation/clinic";
import type { FormValues } from "@/lib/validation/form";

const repo = getRepo();
const row = await repo.clinics.get(Astro.params.id ?? "");
if (!row) return new Response("Not found", { status: 404 });

let values: FormValues = clinicFormValues(row, doctorConfig.contact.defaultCountry);
let errors: Record<string, string> = {};

if (Astro.request.method === "POST") {
  const result = parseClinicForm(await Astro.request.formData());
  if (result.ok) {
    await repo.clinics.update(row.id, result.data);
    return Astro.redirect("/dashboard/clinics?ok=saved", 303);
  }
  values = result.values;
  errors = result.errors;
  Astro.response.status = 422;
}
---
<DashboardLayout title="تعديل عيادة">
  <ClinicForm values={values} errors={errors} cancelHref="/dashboard/clinics" />
</DashboardLayout>
