---
import { doctorConfig } from "@/config";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import ClinicForm from "@/components/dashboard/ClinicForm.astro";
import { weekFromHours } from "@/lib/hours";
import { getRepo } from "@/lib/repo";
import { clinicFormValues, parseClinicForm } from "@/lib/validation/clinic";
import type { FormValues } from "@/lib/validation/form";
import { parseWeekForm, type DayScheduleInput } from "@/lib/validation/working-hours";

const repo = getRepo();
const row = await repo.clinics.get(Astro.params.id ?? "");
if (!row) return new Response("Not found", { status: 404 });

let values: FormValues = clinicFormValues(row, doctorConfig.site.defaultCountry);
// A day with no stored rows shows as closed.
let week: DayScheduleInput[] = weekFromHours(await repo.workingHours.listByClinic(row.id));
let errors: Record<string, string> = {};

if (Astro.request.method === "POST") {
  const fd = await Astro.request.formData();
  const clinic = parseClinicForm(fd);
  const hours = parseWeekForm(fd);
  if (clinic.ok && hours.ok) {
    await repo.clinics.update(row.id, clinic.data);
    await repo.workingHours.replaceWeek(row.id, hours.data);
    return Astro.redirect("/dashboard/clinics?ok=saved", 303);
  }
  // Any error: nothing is saved (neither the clinic nor the hours).
  values = clinic.values;
  week = hours.week;
  errors = { ...(clinic.ok ? {} : clinic.errors), ...(hours.ok ? {} : hours.errors) };
  Astro.response.status = 422;
}
---
<DashboardLayout title="تعديل عيادة">
  <ClinicForm values={values} errors={errors} week={week} cancelHref="/dashboard/clinics" />
</DashboardLayout>
