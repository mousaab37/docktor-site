---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import FaqForm from "@/components/dashboard/FaqForm.astro";
import { getRepo } from "@/lib/repo";
import { parseForm, type FormValues } from "@/lib/validation/form";
import { faqInput } from "@/lib/validation/faq";

// New questions are published by default.
let values: FormValues = { question: "", answer: "", is_published: true };
let errors: Record<string, string> = {};

if (Astro.request.method === "POST") {
  const result = parseForm(faqInput, await Astro.request.formData());
  if (result.ok) {
    await getRepo().faqs.create(result.data);
    return Astro.redirect("/dashboard/faq?ok=saved", 303);
  }
  values = result.values;
  errors = result.errors;
  Astro.response.status = 422;
}
---
<DashboardLayout title="إضافة سؤال">
  <FaqForm values={values} errors={errors} cancelHref="/dashboard/faq" />
</DashboardLayout>
