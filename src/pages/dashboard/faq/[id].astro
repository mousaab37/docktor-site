---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import FaqForm from "@/components/dashboard/FaqForm.astro";
import { getDashboardRepo } from "@/lib/repo";
import { parseForm, type FormValues } from "@/lib/validation/form";
import { faqInput } from "@/lib/validation/faq";

const repo = getDashboardRepo(Astro.locals);
const row = await repo.faqs.get(Astro.params.id ?? "");
if (!row) return new Response("Not found", { status: 404 });

let values: FormValues = {
  question: row.question,
  answer: row.answer,
  is_published: row.is_published,
};
let errors: Record<string, string> = {};

if (Astro.request.method === "POST") {
  const result = parseForm(faqInput, await Astro.request.formData());
  if (result.ok) {
    await repo.faqs.update(row.id, result.data);
    return Astro.redirect("/dashboard/faq?ok=saved", 303);
  }
  values = result.values;
  errors = result.errors;
  Astro.response.status = 422;
}
---
<DashboardLayout title="تعديل سؤال">
  <FaqForm values={values} errors={errors} cancelHref="/dashboard/faq" />
</DashboardLayout>
