---
import { doctorConfig } from "@/config";
import PublicLayout from "@/layouts/PublicLayout.astro";
import { getSeoSetting } from "@/lib/data";

const { privacy, site, doctor } = doctorConfig;
const seo = await getSeoSetting("privacy");
const title = seo?.seo_title || `سياسة الخصوصية | ${doctor.honorific} ${doctor.fullName}`;
const description = seo?.seo_description || undefined;
const ogImage = seo?.og_image || undefined;
const updated = new Intl.DateTimeFormat("ar", { dateStyle: "long", timeZone: "UTC" }).format(new Date(privacy.lastUpdated));
---
<PublicLayout title={title} description={description} ogImage={ogImage}>
  <section class="sec" style="padding-top:clamp(120px,14vw,170px)" aria-labelledby="privacy-h">
    <div class="wrap article-wrap">
      <h1 class="h2" id="privacy-h" data-split>سياسة الخصوصية</h1>
      <p class="article-date">آخر تحديث: <time datetime={privacy.lastUpdated}>{updated}</time></p>
      <div class="prose-ar">
        {privacy.sections.map((s) => (
          <>
            <h2>{s.heading}</h2>
            <p>{s.body}</p>
          </>
        ))}
      </div>
    </div>
  </section>
</PublicLayout>
