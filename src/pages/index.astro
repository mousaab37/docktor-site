---
import PublicLayout from "@/layouts/PublicLayout.astro";
import HeroSection from "@/components/public/HeroSection.astro";
import StatementSection from "@/components/public/StatementSection.astro";
import ServicesSection from "@/components/public/ServicesSection.astro";
import HowToBookSection from "@/components/public/HowToBookSection.astro";
import BandSection from "@/components/public/BandSection.astro";
import AboutSection from "@/components/public/AboutSection.astro";
import CertificatesSection from "@/components/public/CertificatesSection.astro";
import ClinicsSection from "@/components/public/ClinicsSection.astro";
import TestimonialsSection from "@/components/public/TestimonialsSection.astro";
import ArticlesSection from "@/components/public/ArticlesSection.astro";
import FaqSection from "@/components/public/FaqSection.astro";
import ContactSection from "@/components/public/ContactSection.astro";
import { faqNode } from "@/lib/jsonld";
import {
  getActiveCertificates,
  getActiveServices,
  getProfile,
  getActiveClinicsWithHours,
  getActiveStatistics,
  getLatestArticles,
  getPublishedFaqs,
  getPublishedTestimonials,
  getSeoSetting,
} from "@/lib/data";

const [statistics, clinics, certificates, testimonials, articles, seo, profile, services, faqs] = await Promise.all([
  getActiveStatistics(),
  getActiveClinicsWithHours(),
  getActiveCertificates(),
  getPublishedTestimonials(),
  getLatestArticles(3),
  getSeoSetting("global"),
  getProfile(),
  getActiveServices(),
  getPublishedFaqs(),
]);
// Empty SEO fields fall back to the defaults built in `buildMeta`.
---
<PublicLayout title={seo?.seo_title || undefined} fullTitle={!!seo?.seo_title} description={seo?.seo_description} ogImage={seo?.og_image} graph={faqNode(faqs)}>
  <HeroSection clinics={clinics} statistics={statistics} profile={profile} />
  <StatementSection statistics={statistics} profile={profile} />
  <ServicesSection services={services} profile={profile} />
  <HowToBookSection clinicCount={clinics.length} />
  <BandSection services={services} profile={profile} />
  <AboutSection clinicCount={clinics.length} profile={profile} />
  <CertificatesSection certificates={certificates} />
  <ClinicsSection clinics={clinics} profile={profile} />
  <TestimonialsSection testimonials={testimonials} />
  <ArticlesSection articles={articles} />
  <FaqSection faqs={faqs} />
  <ContactSection />
</PublicLayout>
