---
import PublicLayout from "@/layouts/PublicLayout.astro";
import HeroSection from "@/components/public/HeroSection.astro";
import StatementSection from "@/components/public/StatementSection.astro";
import ServicesSection from "@/components/public/ServicesSection.astro";
import HowToBookSection from "@/components/public/HowToBookSection.astro";
import BandSection from "@/components/public/BandSection.astro";
import AboutSection from "@/components/public/AboutSection.astro";
import CertificatesSection from "@/components/public/CertificatesSection.astro";
import ClinicsSection from "@/components/public/ClinicsSection.astro";
import TestimonialsSection from "@/components/public/TestimonialsSection.astro";
import ArticlesSection from "@/components/public/ArticlesSection.astro";
import FaqSection from "@/components/public/FaqSection.astro";
import ContactSection from "@/components/public/ContactSection.astro";
import { faqNode } from "@/lib/jsonld";
import {
  getActiveCertificates,
  getActiveServices,
  getProfile,
  getActiveClinicsWithHours,
  getActiveStatistics,
  getLatestArticles,
  getPublishedFaqs,
  getPublishedTestimonials,
  getSeoSetting,
  getSiteSections,
} from "@/lib/data";

const [sections, allStatistics, allClinics, allCertificates, allTestimonials, allArticles, seo, profile, allServices, allFaqs] = await Promise.all([
  Astro.locals.sections ?? getSiteSections(),
  getActiveStatistics(),
  getActiveClinicsWithHours(),
  getActiveCertificates(),
  getPublishedTestimonials(),
  getLatestArticles(3),
  getSeoSetting("global"),
  getProfile(),
  getActiveServices(),
  getPublishedFaqs(),
]);
// A hidden section shows nothing (and its data is left out of the structured data too).
const statistics = sections.statistics ? allStatistics : [];
const clinics = sections.clinics ? allClinics : [];
const certificates = sections.certificates ? allCertificates : [];
const testimonials = sections.testimonials ? allTestimonials : [];
const articles = sections.blog ? allArticles : [];
const services = sections.services ? allServices : [];
const faqs = sections.faq ? allFaqs : [];
// Empty SEO fields fall back to the defaults built in `buildMeta`.
---
<PublicLayout title={seo?.seo_title || undefined} fullTitle={!!seo?.seo_title} description={seo?.seo_description} ogImage={seo?.og_image} graph={faqNode(faqs)}>
  <HeroSection clinics={clinics} statistics={statistics} profile={profile} />
  <StatementSection statistics={statistics} profile={profile} />
  {sections.services && <ServicesSection services={services} profile={profile} />}
  {sections.how_to_book && <HowToBookSection clinicCount={clinics.length} />}
  {sections.band && <BandSection services={services} profile={profile} />}
  <AboutSection clinicCount={clinics.length} profile={profile} />
  {sections.certificates && <CertificatesSection certificates={certificates} />}
  {sections.clinics && <ClinicsSection clinics={clinics} profile={profile} />}
  {sections.testimonials && <TestimonialsSection testimonials={testimonials} />}
  {sections.blog && <ArticlesSection articles={articles} />}
  {sections.faq && <FaqSection faqs={faqs} />}
  <ContactSection />
</PublicLayout>
