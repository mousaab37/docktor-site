---
import PublicLayout from "@/layouts/PublicLayout.astro";
import HeroSection from "@/components/public/HeroSection.astro";
import StatementSection from "@/components/public/StatementSection.astro";
import ServicesSection from "@/components/public/ServicesSection.astro";
import AboutSection from "@/components/public/AboutSection.astro";
import { getActiveClinicsWithHours, getActiveStatistics } from "@/lib/data";

const [statistics, clinics] = await Promise.all([getActiveStatistics(), getActiveClinicsWithHours()]);
---
<PublicLayout>
  <HeroSection clinics={clinics} statistics={statistics} />
  <StatementSection statistics={statistics} />
  <ServicesSection />
  <AboutSection />
  {/*
    Task 7 adds, in this order: how-to-book steps, band, clinics (map + hours),
    certificates, testimonials, articles, contact.
  */}
</PublicLayout>
