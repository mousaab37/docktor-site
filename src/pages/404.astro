---
import PublicLayout from "@/layouts/PublicLayout.astro";
---
<PublicLayout title="الصفحة غير موجودة" noindex>
  <section class="sec not-found" style="padding-top:clamp(120px,14vw,170px)">
    <div class="wrap">
      <p class="not-found-code" aria-hidden="true">404</p>
      <h1 class="h2">الصفحة غير موجودة</h1>
      <p class="lead">ربما تغيّر الرابط أو حُذفت الصفحة. يمكنك العودة إلى الصفحة الرئيسية أو تصفّح المقالات.</p>
      <div class="cta-row">
        <a class="btn" href="/"><span class="roll"><span data-t="الصفحة الرئيسية">الصفحة الرئيسية</span></span></a>
        <a class="btn btn-ghost" href="/blog"><span class="roll"><span data-t="المقالات">المقالات</span></span></a>
      </div>
    </div>
  </section>
</PublicLayout>
