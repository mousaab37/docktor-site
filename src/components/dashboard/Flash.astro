---
interface Props {
  errors?: Record<string, string>;
}

const { errors = {} } = Astro.props;
const messages: Record<string, string> = {
  saved: "تم الحفظ",
  deleted: "تم الحذف",
  moved: "تم الترتيب",
};
const ok = messages[Astro.url.searchParams.get("ok") ?? ""];
// A failed save (the middleware redirects back with ?err=1).
const failed = Astro.url.searchParams.has("err");
const errorList = Object.values(errors);
---
{errorList.length > 0 && (
  <div class="d-errors" role="alert">
    <strong>يرجى تصحيح الأخطاء التالية:</strong>
    <ul>{errorList.map((e) => <li>{e}</li>)}</ul>
  </div>
)}
{failed && <div class="d-errors" role="alert"><strong>تعذّر الحفظ، حاول مرة أخرى</strong></div>}
{ok && <div class="d-toast" role="status" data-toast>{ok}</div>}

<script>
  // The toast fades after 3 seconds, and "?ok=" is removed from the address bar.
  const toast = document.querySelector<HTMLElement>("[data-toast]");
  if (toast) {
    const url = new URL(location.href);
    url.searchParams.delete("ok");
    history.replaceState(null, "", url.pathname + url.search + url.hash);
    setTimeout(() => toast.classList.add("hide"), 3000);
    setTimeout(() => toast.remove(), 3500);
  }
</script>
