---
import Card from "./Card.astro";
import Field from "./Field.astro";
import FormActions from "./FormActions.astro";
import Toggle from "./Toggle.astro";
import type { FormValues } from "@/lib/validation/form";

interface Props {
  values: FormValues;
  errors?: Record<string, string>;
  cancelHref: string;
  /** Rendered inside a FormDialog: no outer card, a small notice, a hidden id, and "cancel" closes the dialog. */
  inDialog?: boolean;
}

const { values, errors = {}, cancelHref, inDialog = false } = Astro.props;
const Wrapper = inDialog ? "div" : Card;
---
{!inDialog && <div class="d-notice" role="note">انشر رأي المريض فقط بعد أخذ إذنه.</div>}
<Wrapper>
  <form method="post" class="d-form" novalidate data-testimonial-form action={inDialog ? "/dashboard/testimonials" : undefined}>
    <input type="hidden" name="intent" value="save" />
    {inDialog && <input type="hidden" name="id" value={String(values.id ?? "")} />}
    {inDialog && <p class="d-notice sm" role="note">انشر رأي المريض فقط بعد أخذ إذنه.</p>}
    <Field
      name="display_name"
      label="الاسم المعروض"
      value={String(values.display_name ?? "")}
      error={errors.display_name}
      required
      maxlength={80}
      hint="يُفضَّل الأحرف الأولى فقط، مثل م. ع."
    />
    <Field as="textarea" name="content" label="نص الرأي" value={String(values.content ?? "")} error={errors.content} required maxlength={1000} rows={5} />
    <Field name="testimonial_date" type="date" label="التاريخ (اختياري)" value={String(values.testimonial_date ?? "")} error={errors.testimonial_date} dir="ltr" />
    <Toggle name="is_published" label="منشور في الموقع" checked={values.is_published === true} />
    <FormActions cancelHref={cancelHref} dialog={inDialog} />
  </form>
</Wrapper>

<script>
  // When the form lives in a dialog, fill it from the row JSON on the button that opened the dialog.
  interface Row {
    id: string;
    display_name: string;
    content: string;
    testimonial_date: string | null;
    is_published: boolean;
  }
  document.querySelectorAll<HTMLFormElement>("dialog form[data-testimonial-form]").forEach((form) => {
    const dialog = form.closest("dialog");
    dialog?.addEventListener("dialog-prefill", (e) => {
      const trigger = (e as CustomEvent<{ trigger: HTMLElement }>).detail.trigger;
      const row: Row = JSON.parse(trigger.dataset.row ?? "{}");
      const set = (name: string, value: string) => {
        (form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement).value = value;
      };
      set("id", row.id ?? "");
      set("display_name", row.display_name ?? "");
      set("content", row.content ?? "");
      set("testimonial_date", row.testimonial_date ?? "");
      (form.elements.namedItem("is_published") as HTMLInputElement).checked = row.is_published === true;
      form.querySelectorAll(".err").forEach((el) => el.remove());
      form.querySelectorAll(".has-error").forEach((el) => el.classList.remove("has-error"));
      form.querySelectorAll("input, textarea").forEach((el) => el.dispatchEvent(new Event("input")));
    });
  });
</script>
