---
import Card from "./Card.astro";
import Field from "./Field.astro";
import FormActions from "./FormActions.astro";
import Toggle from "./Toggle.astro";
import type { FormValues } from "@/lib/validation/form";

interface Props {
  values: FormValues;
  errors?: Record<string, string>;
  cancelHref: string;
}

const { values, errors = {}, cancelHref } = Astro.props;
---
<div class="d-notice" role="note">انشر رأي المريض فقط بعد أخذ إذنه.</div>
<Card>
  <form method="post" class="d-form" novalidate>
    <input type="hidden" name="intent" value="save" />
    <Field
      name="display_name"
      label="الاسم المعروض"
      value={String(values.display_name ?? "")}
      error={errors.display_name}
      required
      maxlength={80}
      hint="يُفضَّل الأحرف الأولى فقط، مثل م. ع."
    />
    <Field as="textarea" name="content" label="نص الرأي" value={String(values.content ?? "")} error={errors.content} required maxlength={1000} rows={6} />
    <Field name="testimonial_date" type="date" label="التاريخ (اختياري)" value={String(values.testimonial_date ?? "")} error={errors.testimonial_date} dir="ltr" />
    <Toggle name="is_published" label="منشور في الموقع" checked={values.is_published === true} />
    <FormActions cancelHref={cancelHref} />
  </form>
</Card>
