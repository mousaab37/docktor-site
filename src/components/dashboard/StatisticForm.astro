---
import Card from "./Card.astro";
import Field from "./Field.astro";
import FormActions from "./FormActions.astro";
import Toggle from "./Toggle.astro";
import type { FormValues } from "@/lib/validation/form";

interface Props {
  values: FormValues;
  errors?: Record<string, string>;
  cancelHref: string;
}

const { values, errors = {}, cancelHref } = Astro.props;
---
<Card>
  <form method="post" class="d-form" novalidate>
    <input type="hidden" name="intent" value="save" />
    <Field name="label" label="العنوان" value={String(values.label ?? "")} error={errors.label} required maxlength={80} />
    <Field
      name="value"
      label="القيمة"
      value={String(values.value ?? "")}
      error={errors.value}
      required
      maxlength={20}
      dir="ltr"
      hint="رقم أو نص قصير مثل 15+"
    />
    <Field as="textarea" name="description" label="وصف (اختياري)" value={String(values.description ?? "")} error={errors.description} maxlength={300} rows={3} />
    <Toggle name="is_active" label="ظاهر في الموقع" checked={values.is_active === true} />
    <FormActions cancelHref={cancelHref} />
  </form>
</Card>
