---
import { PHONE_COUNTRIES, type PhoneCountry } from "@/lib/phone";

interface Props {
  /** Base name: the fields are `<name>_country` (hidden) and `<name>_national`. */
  name: "phone" | "whatsapp";
  label: string;
  country: PhoneCountry;
  national: string;
  error?: string;
  hint?: string;
  required?: boolean;
}

const { name, label, country, national, error, hint, required = false } = Astro.props;
const id = `f-${name}_national`;
// The country list for the browser, generated from PHONE_COUNTRIES (same order, Syria first).
const countries = PHONE_COUNTRIES.map((c) => c.code.toLowerCase()).join(",");
---
<div class:list={["field", "phone-field", error && "has-error"]} data-phone-field={name} data-countries={countries}>
  <label for={id}>{label}{required && <span class="req" aria-hidden="true">*</span>}</label>
  <div class="phone-box" dir="ltr">
    <input type="hidden" name={`${name}_country`} value={country} />
    <input
      id={id}
      name={`${name}_national`}
      type="tel"
      inputmode="tel"
      autocomplete="tel-national"
      value={national}
      aria-invalid={error ? "true" : undefined}
      aria-describedby={[hint ? `${id}-hint` : null, error ? `${id}-err` : null].filter(Boolean).join(" ") || undefined}
    />
  </div>
  {hint && <p class="hint" id={`${id}-hint`}>{hint}</p>}
  {error && <p class="err" id={`${id}-err`}>{error}</p>}
</div>

<script>
  import "@/scripts/phone-fields";
</script>
