---
interface Props {
  message: string;
  addHref?: string;
  addLabel?: string;
}

const { message, addHref, addLabel = "إضافة" } = Astro.props;
---
<div class="d-empty">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7l9-4 9 4-9 4-9-4z" /><path d="M3 12l9 4 9-4M3 17l9 4 9-4" /></svg>
  <p>{message}</p>
  {addHref && <a class="btn btn-sm" href={addHref}>{addLabel}</a>}
</div>
