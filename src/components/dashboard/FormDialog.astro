---
interface Props {
  id: string;
  title: string;
  /** Render the dialog already open (used after a validation error). */
  open?: boolean;
  size?: "sm" | "md";
}

const { id, title, open = false, size = "sm" } = Astro.props;
---
<dialog id={id} class:list={["d-dialog", size === "md" && "md"]} aria-labelledby={`${id}-title`} data-open-on-load={open ? "" : undefined}>
  <div class="d-dialog-inner">
    <div class="d-dialog-head">
      <h2 id={`${id}-title`} data-dialog-title>{title}</h2>
      <button class="d-dialog-close" type="button" aria-label="إغلاق" data-dialog-close>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
    <div class="d-dialog-body"><slot /></div>
  </div>
</dialog>

<script>
  // Generic dialog behaviour for every <FormDialog>:
  //  - a link/button with data-dialog-open="<id>" opens it (the href stays as the no-JS fallback)
  //  - Esc (native), the × button, any [data-dialog-close] button and a click on the backdrop close it
  //  - focus goes to the first field on open and back to the opener on close
  //  - a dialog rendered with data-open-on-load (after a validation error) opens itself
  const openers = new WeakMap<HTMLDialogElement, HTMLElement>();

  const open = (dialog: HTMLDialogElement, opener?: HTMLElement) => {
    if (opener) openers.set(dialog, opener);
    if (!dialog.open) dialog.showModal();
    dialog.querySelector<HTMLElement>("input:not([type=hidden]), textarea, select")?.focus();
  };

  document.addEventListener("click", (e) => {
    const target = e.target as Element | null;

    const trigger = target?.closest<HTMLElement>("[data-dialog-open]");
    if (trigger) {
      const me = e as MouseEvent;
      // Let ctrl/cmd/shift/middle clicks open the fallback page in a new tab.
      if (me.button !== 0 || me.metaKey || me.ctrlKey || me.shiftKey || me.altKey) return;
      const dialog = document.getElementById(trigger.dataset.dialogOpen ?? "");
      if (dialog instanceof HTMLDialogElement) {
        e.preventDefault();
        const heading = dialog.querySelector("[data-dialog-title]");
        if (heading && trigger.dataset.title) heading.textContent = trigger.dataset.title;
        // The form inside listens to this event and fills its fields from the trigger.
        dialog.dispatchEvent(new CustomEvent("dialog-prefill", { detail: { trigger } }));
        open(dialog, trigger);
      }
      return;
    }

    const closer = target?.closest<HTMLElement>("[data-dialog-close]");
    if (closer) {
      closer.closest("dialog")?.close();
      return;
    }

    // A click on the backdrop lands on the <dialog> element itself (its content is in .d-dialog-inner).
    if (target instanceof HTMLDialogElement && target.classList.contains("d-dialog")) target.close();
  });

  document.querySelectorAll<HTMLDialogElement>("dialog.d-dialog").forEach((dialog) => {
    dialog.addEventListener("close", () => {
      const opener = openers.get(dialog);
      if (opener && document.contains(opener)) opener.focus();
    });
    if (dialog.hasAttribute("data-open-on-load")) open(dialog);
  });
</script>
