---
import { SOCIAL_NAMES } from "@/lib/services";
import type { Profile } from "@/lib/types";
import SocialIcon from "./SocialIcon.astro";

interface Props {
  socials: Profile["socials"];
}

const { socials } = Astro.props;
---
{socials.length > 0 && (
  <div class="hero-socials rv">
    <span class="hero-socials-label">تابعنا</span>
    <ul class="social-links">
      {socials.map((s) => (
        <li>
          <a href={s.url} target="_blank" rel="noopener me" aria-label={SOCIAL_NAMES[s.platform] ?? s.platform}>
            <SocialIcon platform={s.platform} />
          </a>
        </li>
      ))}
    </ul>
  </div>
)}
