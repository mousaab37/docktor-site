---
import { pickFeatured } from "@/lib/services";
import type { Profile, Service } from "@/lib/types";
import { getSectionLinks, isCurrentLink } from "@/lib/nav";
import Logo from "./Logo.astro";
import WhatsAppButton from "./WhatsAppButton.astro";

interface Props {
  clinicCount: number;
  profile: Profile;
  services: Service[];
}

const { clinicCount, profile, services } = Astro.props;
const sectionLinks = getSectionLinks(clinicCount);
const current = (href: string) => (isCurrentLink(href, Astro.url.pathname) ? "page" : undefined);
const promo = pickFeatured(services);
// Generic medical icons for the mega menu items (cycled).
const icons = [
  "M12 3s7 7.5 7 12a7 7 0 0 1-14 0c0-4.5 7-12 7-12z",
  "M3 12h4l2-5 4 10 2-5h6",
  "M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.7 3h10.6a2 2 0 0 0 1.7-3l-5-9V3M7.5 15h9",
  "M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6M12 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8z",
  "M5 12.5l4.5 4.5L19 7.5",
  "M12 5v14M5 12h14",
];
const phone = profile.phone;
const tel = phone ? `tel:${phone.replace(/[^\d+]/g, "")}` : null;
---
<a class="skip" href="#main">تخطَّ إلى المحتوى</a>
<header class="hdr" id="top">
  <div class="wrap hdr-in">
    <Logo />
    <nav class="nav" aria-label="التنقل الرئيسي">
      {sectionLinks.map((l) =>
        l.href === "/#services" ? (
          <>
            <a class="nojs-only" href={l.href} aria-current={current(l.href)}>{l.label}</a>
            <button class="js-only" type="button" aria-expanded="false" aria-controls="mega" data-mega>
              {l.label}
              <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 4.5l4 4 4-4" /></svg>
            </button>
          </>
        ) : (
          <a href={l.href} aria-current={current(l.href)}>{l.label}</a>
        ),
      )}
    </nav>
    <div class="hdr-r">
      {tel && phone && <a class="hdr-tel" href={tel}><bdi dir="ltr">{phone}</bdi></a>}
      <WhatsAppButton size="sm" label="واتساب" />
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu>
        <i aria-hidden="true"></i><span>القائمة</span>
      </button>
    </div>
  </div>
  <div class="mega" id="mega">
    <div class="wrap mega-in">
      {services.map((svc, i) => (
        <a class="m-item" href="/#services">
          <span class="m-ico">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[i % icons.length]} /></svg>
          </span>
          <b>{svc.title}</b>
          <span>{svc.description}</span>
        </a>
      ))}
      {promo && (
      <div class="m-promo">
        <span class="ph">{promo.image_path && <img src={promo.image_path} alt="" width="1600" height="1067" loading="lazy" />}</span>
        <div>
          <span><small>خدمة مميزة</small><strong>{promo.title}</strong></span>
          <p>{promo.description}</p>
          <WhatsAppButton size="sm" label="اسأل عبر واتساب" message={`مرحبًا، أود الاستفسار عن: ${promo.title}`} />
        </div>
      </div>
      )}
    </div>
  </div>
</header>
<nav class="menu" id="menu" aria-label="قائمة الموقع">
  <div class="menu-list">
    <ul>
      {sectionLinks.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
    </ul>
    <div class="menu-foot">
      {tel && phone && <a href={tel}><bdi dir="ltr">{phone}</bdi></a>}
      <WhatsAppButton size="sm" />
    </div>
  </div>
</nav>
