---
import { clinicsWord } from "@/lib/arabic";
import { profileView } from "@/lib/profile-view";
import type { Profile } from "@/lib/types";

interface Props {
  clinicCount: number;
  profile: Profile;
}

const { clinicCount, profile } = Astro.props;
const doctor = profileView(profile);
const rest = doctor.bio.slice(1);
---
<section class="sec" id="about" aria-labelledby="about-h">
  <div class="wrap">
    <div class="clinic rv">
      <div class="clinic-t">
        <span class="eyebrow">نبذة</span>
        <h2 id="about-h">عن الطبيب</h2>
        {rest.map((p) => <p>{p}</p>)}
        <div><a class="btn btn-ghost" href="/#clinics"><span class="roll"><span data-t={`${clinicsWord(clinicCount)} والمواعيد`}>{clinicsWord(clinicCount)} والمواعيد</span></span></a></div>
      </div>
      <div class="ph">{doctor.photo && <img src={doctor.photo.src} alt={doctor.photo.alt} width="1024" height="1536" loading="lazy" data-par="0.06" />}</div>
    </div>

    {(doctor.education.length > 0 || doctor.experience.length > 0) && (
      <div class="plist-grid">
        {doctor.education.length > 0 && (
          <div class="plist rv">
            <h3>التعليم</h3>
            <ul>
              {doctor.education.map((e) => (
                <li>
                  <div><b>{e.degree}</b><span>{e.institution}</span></div>
                  {e.year && <em><bdi>{e.year}</bdi></em>}
                </li>
              ))}
            </ul>
          </div>
        )}
        {doctor.experience.length > 0 && (
          <div class="plist rv" style="--d:1">
            <h3>الخبرة</h3>
            <ul>
              {doctor.experience.map((x) => (
                <li>
                  <div><b>{x.role}</b><span>{x.place}</span></div>
                  <em><bdi>{x.period}</bdi></em>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
  </div>
</section>
