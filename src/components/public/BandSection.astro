---
import type { Profile, Service } from "@/lib/types";

interface Props {
  services: Service[];
  profile: Profile;
}

const { services, profile } = Astro.props;
const words = [...services.map((s) => s.title), profile.specialty];
---
<div class="band" aria-hidden="true">
  <div class="track">
    {[0, 1].map(() =>
      words.map((w) => (
        <span>
          {w}
          <svg viewBox="0 0 32 32"><g fill="currentColor"><path d="M16 15c-3-2.8-3-7.6 0-10.6 3 3 3 7.8 0 10.6z" /><path d="M16 17c3 2.8 3 7.6 0 10.6-3-3-3-7.8 0-10.6z" /><path d="M15 16c-2.8 3-7.6 3-10.6 0 3-3 7.8-3 10.6 0z" /><path d="M17 16c2.8-3 7.6-3 10.6 0-3 3-7.8 3-10.6 0z" /></g></svg>
        </span>
      )),
    )}
  </div>
</div>
