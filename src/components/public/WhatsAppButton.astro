---
import { doctorConfig } from "@/config";
import { waLink } from "@/lib/whatsapp";

interface Props {
  number?: string;
  message?: string;
  label?: string;
  variant?: "primary" | "ghost";
  size?: "md" | "sm";
  class?: string;
}

const {
  number = doctorConfig.contact.whatsapp,
  message = doctorConfig.whatsapp.defaultMessage,
  label = "تواصل عبر واتساب",
  variant = "primary",
  size = "md",
  class: extra = "",
} = Astro.props;

const classes = ["btn", variant === "ghost" && "btn-ghost", size === "sm" && "btn-sm", extra]
  .filter(Boolean)
  .join(" ");
---
<a class={classes} href={waLink(number, message)} target="_blank" rel="noopener">
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.43 15.07L2 22l5.07-1.58A9.9 9.9 0 1 0 12.04 2zm0 1.8a8.1 8.1 0 1 1-4.2 15.03l-.3-.18-3 .93.97-2.92-.2-.31A8.1 8.1 0 0 1 12.04 3.8zM8.6 7.4c-.2 0-.5.07-.75.35-.26.28-1 1-1 2.4s1.03 2.8 1.17 3c.15.2 2.03 3.2 5 4.4 2.46.97 2.96.78 3.5.73.53-.05 1.7-.7 1.95-1.37.24-.68.24-1.26.17-1.38-.07-.12-.27-.2-.56-.34-.3-.15-1.7-.84-1.97-.94-.26-.1-.46-.15-.65.15-.2.3-.75.94-.92 1.13-.17.2-.34.22-.63.07-.3-.15-1.24-.46-2.36-1.45-.87-.78-1.46-1.74-1.63-2.03-.17-.3-.02-.46.13-.6.13-.13.3-.35.44-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.65-1.58-.9-2.16-.23-.56-.47-.48-.65-.49h-.55z" /></svg>
  <span>{label}</span>
</a>
