---
import WhatsAppButton from "./WhatsAppButton.astro";
// The home page keeps only a short call to action; every way to get in touch is on /contact.
---
<section class="sec book" id="contact" aria-labelledby="contact-h">
  <div class="wrap">
    <div class="book-l">
      <span class="eyebrow">تواصل</span>
      <h2 class="h2" id="contact-h" data-split>تواصل <em>معنا</em></h2>
      <p class="lead">أسرع طريقة للحجز أو الاستفسار هي رسالة واتساب.</p>
      <div class="cta-row">
        <WhatsAppButton label="تواصل عبر واتساب" />
        <a class="btn btn-ghost" href="/contact"><span class="roll"><span data-t="كل طرق التواصل">كل طرق التواصل</span></span></a>
      </div>
    </div>
  </div>
</section>
