---
import { clinicsWord } from "@/lib/arabic";
import type { ClinicWithHours, Profile } from "@/lib/types";
import BookingNotice from "./BookingNotice.astro";
import ClinicCard from "./ClinicCard.astro";

interface Props {
  clinics: ClinicWithHours[];
  profile: Profile;
}

const { clinics, profile } = Astro.props;
---
{clinics.length > 0 && (
  <section class="sec" id="clinics" aria-labelledby="clinics-h">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">{clinicsWord(clinics.length)}</span>
          <h2 class="h2" id="clinics-h" data-split>أين تجدنا <em>ومتى</em></h2>
        </div>
        <p class="lead rv">اختر العيادة الأقرب وراسلنا على واتساب. ستجد اسم العيادة في الرسالة الجاهزة.</p>
      </div>

      <div class="clinics-grid">
        {clinics.map((c, i) => <ClinicCard clinic={c} fallbackNumber={profile.whatsapp} index={i} />)}
      </div>

      <div style="margin-top:20px"><BookingNotice /></div>
    </div>
  </section>
)}
