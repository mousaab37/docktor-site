---
import { doctorConfig } from "@/config";

interface Props {
  class?: string;
}

const { brand } = doctorConfig;
const { class: extra = "" } = Astro.props;
---
<a class={`logo ${extra}`.trim()} href="/" aria-label={`${brand.logoText} — الصفحة الرئيسية`}>
  {brand.logoImage ? (
    <img src={brand.logoImage} alt="" height="32" style="height:32px;width:auto" />
  ) : (
    <svg viewBox="0 0 32 32" aria-hidden="true">
      <rect width="32" height="32" rx="9" fill="var(--logo-bg, var(--brand-primary))" />
      <g fill="var(--logo-fg, var(--brand-accent))">
        <path d="M16 15c-3-2.8-3-7.6 0-10.6 3 3 3 7.8 0 10.6z" />
        <path d="M16 17c3 2.8 3 7.6 0 10.6-3-3-3-7.8 0-10.6z" />
        <path d="M15 16c-2.8 3-7.6 3-10.6 0 3-3 7.8-3 10.6 0z" />
        <path d="M17 16c2.8-3 7.6-3 10.6 0-3 3-7.8 3-10.6 0z" />
      </g>
    </svg>
  )}
  <span>{brand.logoText}</span>
</a>
