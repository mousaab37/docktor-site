---
import SocialIcon from "./SocialIcon.astro";
import { SOCIAL_NAMES } from "@/lib/services";
import { doctorConfig } from "@/config";
import { getSectionLinks, isCurrentLink } from "@/lib/nav";
import { profileView } from "@/lib/profile-view";
import type { Profile } from "@/lib/types";
import { waLink } from "@/lib/whatsapp";
import Logo from "./Logo.astro";

interface Props {
  clinicCount: number;
  profile: Profile;
}

const { clinicCount, profile } = Astro.props;
const sectionLinks = getSectionLinks(clinicCount);
const current = (href: string) => (isCurrentLink(href, Astro.url.pathname) ? "page" : undefined);
const { brand } = doctorConfig;
const doctor = profileView(profile);
const year = new Date().getFullYear();
const tel = profile.phone ? `tel:${profile.phone.replace(/[^\d+]/g, "")}` : null;
---
<footer class="foot dark">
  <div class="wrap">
    <div class="f-grid">
      <div class="f-about">
        <Logo />
        <p>{doctor.shortIntro}</p>
      </div>
      <nav aria-labelledby="f-links">
        <h2 id="f-links">روابط</h2>
        <ul>
          {sectionLinks.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
        </ul>
      </nav>
      <div>
        <h2>تواصل معنا</h2>
        <ul>
          {tel && profile.phone && <li><a href={tel}><bdi dir="ltr">{profile.phone}</bdi></a></li>}
          <li><a href={waLink(profile.whatsapp, profile.whatsapp_default_message)} target="_blank" rel="noopener">واتساب</a></li>
          {profile.email && <li><a href={`mailto:${profile.email}`}><bdi dir="ltr">{profile.email}</bdi></a></li>}
        </ul>
        {profile.socials.length > 0 && (
          <ul class="social-links" style="margin-top:14px">
            {profile.socials.map((s) => (
              <li><a href={s.url} target="_blank" rel="noopener" aria-label={SOCIAL_NAMES[s.platform] ?? s.platform}><SocialIcon platform={s.platform} /></a></li>
            ))}
          </ul>
        )}
      </div>
    </div>
    <div class="legal">
      <p>© <bdi>{year}</bdi> {doctor.honorific} {doctor.fullName}</p>
      <ul><li><a href="/privacy">سياسة الخصوصية</a></li></ul>
    </div>
  </div>
  <div class="giant" aria-hidden="true">{brand.logoText}</div>
</footer>
