---
import c from "../content.json";
---
<section class="sec" id="visit" aria-labelledby="visit-h" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">{c.visit.span_1}</span>
          <h2 class="h2" id="visit-h" data-split set:html={c.visit.h2_2_html}></h2>
        </div>
        <p class="lead rv">{c.visit.p_3}</p>
      </div>
      <div class="visit-grid">
        <div class="visit-media ph" aria-hidden="true">
          <div class="ph on" data-shot="0"><img style="object-position:40% 50%" src={"/" + c.visit.img_4_image} alt width="1600" height="1067" loading="lazy"></div>
          <div class="ph" data-shot="1"><img style="object-position:62% 50%" src={"/" + c.visit.img_5_image} alt width="1600" height="1067" loading="lazy"></div>
          <div class="ph" data-shot="2"><img style="object-position:58% 50%" src={"/" + c.visit.img_6_image} alt width="1600" height="1067" loading="lazy"></div>
          <div class="ph" data-shot="3"><img style="object-position:55% 50%" src={"/" + c.visit.img_7_image} alt width="1600" height="1067" loading="lazy"></div>
          <div class="vcount"><span data-vnum>{c.visit.span_8}</span><small>{c.visit.small_9}</small></div>
        </div>
        <ol class="steps">
          <li class="step on" data-step="0">
            <div class="ph"><img src={"/" + c.visit.img_10_image} alt={c.visit.img_10_alt} width="1600" height="1067" loading="lazy"></div>
            <span class="n">{c.visit.span_11}</span>
            <h3>{c.visit.h3_12}</h3>
            <p>{c.visit.p_13}</p>
            <ul class="tags"><li>{c.visit.li_14}</li><li>{c.visit.li_15}</li></ul>
          </li>
          <li class="step" data-step="1">
            <div class="ph"><img src={"/" + c.visit.img_16_image} alt={c.visit.img_16_alt} width="1600" height="1067" loading="lazy"></div>
            <span class="n">{c.visit.span_17}</span>
            <h3>{c.visit.h3_18}</h3>
            <p>{c.visit.p_19}</p>
            <ul class="tags"><li>{c.visit.li_20}</li><li>{c.visit.li_21}</li></ul>
          </li>
          <li class="step" data-step="2">
            <div class="ph"><img src={"/" + c.visit.img_22_image} alt={c.visit.img_22_alt} width="1600" height="1067" loading="lazy"></div>
            <span class="n">{c.visit.span_23}</span>
            <h3>{c.visit.h3_24}</h3>
            <p>{c.visit.p_25}</p>
            <ul class="tags"><li>{c.visit.li_26}</li><li>{c.visit.li_27}</li></ul>
          </li>
          <li class="step" data-step="3">
            <div class="ph"><img src={"/" + c.visit.img_28_image} alt={c.visit.img_28_alt} width="1600" height="1067" loading="lazy"></div>
            <span class="n">{c.visit.span_29}</span>
            <h3>{c.visit.h3_30}</h3>
            <p>{c.visit.p_31}</p>
            <ul class="tags"><li>{c.visit.li_32}</li><li>{c.visit.li_33}</li></ul>
          </li>
        </ol>
      </div>
    </div>
  </section>
