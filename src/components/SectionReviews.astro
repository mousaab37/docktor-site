          <svg viewBox="0 0 34 26" fill="currentColor" aria-hidden="true"><path d="M0 26V15.6C0 6.8 4.6 1.6 13.4 0l1.4 3.8C9.8 5.2 7.6 8 7.4 12H14v14H0zm20 0V15.6C20 6.8 24.6 1.6 33.4 0l1.4 3.8C29.8 5.2 27.6 8 27.4 12H34v14H20z" /></svg>
