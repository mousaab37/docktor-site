---
/*
 * FORM PATTERN for every dashboard page (copy it, do not invent another one):
 *
 *  1. The page handles POST in its frontmatter:
 *       const fd = await Astro.request.formData();
 *       const intent = fd.get("intent");
 *  2. Valid input -> do the change, then redirect (POST-redirect-GET):
 *       return Astro.redirect(Astro.url.pathname + "?ok=saved");
 *  3. Invalid input -> render the form again with `errors` and the typed `values`,
 *     and set the status to 422:  Astro.response.status = 422;
 *  4. Astro's `security.checkOrigin` (on by default for server output) blocks cross-site
 *     form posts. Do not turn it off.
 */
import "@/styles/dashboard.css";
import BaseLayout from "./BaseLayout.astro";
import Logo from "@/components/public/Logo.astro";
import { dashboardNav } from "@/lib/dashboard-nav";
import { SECTION_INFO } from "@/lib/dashboard/sections";
import { getSecret, SUPABASE_URL } from "astro:env/server";
import { getDashboardRepo } from "@/lib/repo";
import { publicImageUrl } from "@/lib/storage";
import { allSectionsVisible, SECTION_KEYS } from "@/lib/types";

interface Props {
  /** The page heading. */
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
// The sample data in memory is only used in DEV when Supabase is not configured; never when Supabase is in use.
const usingMemory = import.meta.env.DEV && (!SUPABASE_URL || !getSecret("SUPABASE_KEY"));
// The sidebar needs the profile (account card) and which sections are hidden (a small dot). A failure never blocks the page.
let sections = allSectionsVisible();
let doctorName = "";
let photo: string | null = null;
try {
  const repo = getDashboardRepo(Astro.locals);
  const [s, profile] = await Promise.all([repo.sections.getAll(), repo.profile.get()]);
  sections = s;
  doctorName = `${profile.honorific} ${profile.full_name}`.trim();
  photo = publicImageUrl(profile.photo_path, "profile");
} catch {
  // keep the defaults
}
const hiddenTabs = new Set(SECTION_KEYS.filter((k) => !sections[k]).map((k) => SECTION_INFO[k].tab));
const email = Astro.locals.user?.email ?? "";
// Initials for the avatar when there is no photo: the first letters of the first two words after the title.
const initials = doctorName.replace(/^د\.\s*/, "").split(/\s+/).filter(Boolean).slice(0, 2).map((w) => Array.from(w)[0]).join("") || "د";
const current = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (path: string) => (path === "/dashboard" ? current === path : current === path || current.startsWith(path + "/"));
---
<BaseLayout title={title === "لوحة التحكم" ? title : `${title} | لوحة التحكم`} noindex>
  {usingMemory && <div class="dash-dev-note" role="note">وضع التطوير: البيانات تجريبية في الذاكرة</div>}

  <div class="dash-wrap">
    <div class="dash-top">
      <Logo href="/dashboard" />
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="dash-side" data-dash-menu style="display:inline-flex">
        <i aria-hidden="true"></i><span>القائمة</span>
      </button>
    </div>
    <div class="dash-backdrop" data-dash-backdrop></div>

    <aside class="dash-side" id="dash-side" aria-label="أقسام لوحة التحكم">
      <Logo href="/dashboard" />
      <nav aria-label="أقسام لوحة التحكم" style="flex:1;display:flex">
        <ul class="dash-nav">
          {dashboardNav.map((item) => (
            <li>
              <a href={item.path} aria-current={isCurrent(item.path) ? "page" : undefined}>
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={item.icon} />
                {item.label}
                {hiddenTabs.has(item.path) && <><span class="dash-hidden-dot" aria-hidden="true"></span><span class="sr-only">(القسم مخفي)</span></>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="dash-account">
        <div class="dash-acc-top">
          <span class="dash-avatar" aria-hidden="true">{photo ? <img src={photo} alt="" width="40" height="40" /> : initials}</span>
          <div class="dash-acc-text">
            {doctorName && <p class="dash-acc-name">{doctorName}</p>}
            {email && <p class="dash-acc-email" dir="ltr" title={email}>{email}</p>}
          </div>
        </div>
        <a class="dash-acc-btn dash-acc-view" href="/" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="rtl:-scale-x-100"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" /></svg>
          عرض الموقع
        </a>
        <form method="post" action="/logout">
          <button class="dash-acc-btn dash-acc-out" type="submit">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="rtl:-scale-x-100"><path d="M9 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h4M16 8l4 4-4 4M20 12H9" /></svg>
            تسجيل الخروج
          </button>
        </form>
      </div>
    </aside>

    <main class="dash-main" id="main">
      <div class="dash-inner">
        <h1 class="dash-h1">{title}</h1>
        {description && <p class="dash-desc">{description}</p>}
        <div class="dash-content"><slot /></div>
      </div>
    </main>
  </div>

  <script>
    // Dashboard drawer (same pattern as the public mobile menu): Esc closes it, links close it,
    // the page behind does not scroll, and focus moves in and back.
    const side = document.querySelector<HTMLElement>("#dash-side");
    const backdrop = document.querySelector<HTMLElement>("[data-dash-backdrop]");
    const btn = document.querySelector<HTMLButtonElement>("[data-dash-menu]");
    if (side && backdrop && btn) {
      const set = (open: boolean) => {
        side.classList.toggle("open", open);
        backdrop.classList.toggle("open", open);
        btn.setAttribute("aria-expanded", String(open));
        document.body.style.overflow = open ? "hidden" : "";
        if (open) side.querySelector<HTMLElement>("a")?.focus({ preventScroll: true });
      };
      btn.addEventListener("click", () => set(!side.classList.contains("open")));
      backdrop.addEventListener("click", () => set(false));
      side.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => set(false)));
      window.addEventListener("resize", () => {
        if (window.innerWidth > 1023) set(false);
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && side.classList.contains("open")) {
          set(false);
          btn.focus();
        }
      });
    }

    // Any submit button with data-confirm asks first.
    document.addEventListener("click", (e) => {
      const target = e.target as Element | null;
      const el = target?.closest<HTMLElement>("[data-confirm]");
      if (el && !window.confirm(el.dataset.confirm ?? "")) e.preventDefault();
    });
  </script>
</BaseLayout>
