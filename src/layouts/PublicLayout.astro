---
import BaseLayout from "./BaseLayout.astro";
import Header from "@/components/public/Header.astro";
import Footer from "@/components/public/Footer.astro";
import CompareButton from "@/components/dev/CompareButton.astro";
import { getActiveClinicCount, getActiveServices, getProfile } from "@/lib/data";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, ogImage, noindex } = Astro.props;
// Loaded once per page and passed down.
const [clinicCount, profile, services] = await Promise.all([getActiveClinicCount(), getProfile(), getActiveServices()]);
---
<BaseLayout title={title} description={description} ogImage={ogImage} noindex={noindex}>
  <slot name="head" slot="head" />
  <Header clinicCount={clinicCount} profile={profile} services={services} />
  <main id="main"><slot /></main>
  <Footer clinicCount={clinicCount} profile={profile} />
  <CompareButton to="old" />
  <script>
    import "@/scripts/motion";
  </script>
</BaseLayout>
