---
import "@/styles/global.css";
import { doctorConfig } from "@/config";
import arabicFont400 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url";
import type { Meta } from "@/lib/seo";

interface Props {
  /** Everything the public pages print (title, description, canonical, Open Graph, robots). Built by `buildMeta`. */
  meta?: Meta;
  /** Private pages (dashboard, login) only give a title; they are always noindex. */
  title?: string;
  noindex?: boolean;
  /** An image to preload (the hero photo of the home page). */
  preloadImage?: string | null;
}

const { site, brand } = doctorConfig;
const { meta, title = site.defaultTitle, noindex = false, preloadImage = null } = Astro.props;
const pageTitle = meta?.title ?? title;
const robots = meta?.robots ?? (noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large,max-snippet:-1");
const preload = preloadImage && !preloadImage.startsWith("data:") ? preloadImage : null;
const brandVars = `:root{--brand-primary:${brand.primary};--brand-accent:${brand.accent};}`;
const enc = (hex: string) => hex.replace("#", "%23");
const favicon =
  "data:image/svg+xml," +
  `%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='${enc(brand.primary)}'/%3E%3Cg fill='${enc(brand.accent)}'%3E%3Cpath d='M16 15c-3-2.8-3-7.6 0-10.6 3 3 3 7.8 0 10.6z'/%3E%3Cpath d='M16 17c3 2.8 3 7.6 0 10.6-3-3-3-7.8 0-10.6z'/%3E%3Cpath d='M15 16c-2.8 3-7.6 3-10.6 0 3-3 7.8-3 10.6 0z'/%3E%3Cpath d='M17 16c2.8-3 7.6-3 10.6 0-3 3-7.8 3-10.6 0z'/%3E%3C/g%3E%3C/svg%3E`;
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="robots" content={robots} />
  {meta && <meta name="description" content={meta.description} />}
  {meta && <link rel="canonical" href={meta.canonical} />}
  {meta && <link rel="alternate" hreflang="ar" href={meta.canonical} />}
  {meta && <link rel="alternate" hreflang="x-default" href={meta.canonical} />}
  {meta && Object.entries(meta.og).map(([k, v]) => <meta property={k} content={v} />)}
  {meta && Object.entries(meta.twitter).map(([k, v]) => <meta name={k} content={v} />)}
  {meta && Object.entries(meta.article).map(([k, v]) => <meta property={k} content={v} />)}
  <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
  <link rel="preload" as="font" type="font/woff2" href={arabicFont400} crossorigin />
  {preload && <link rel="preload" as="image" href={preload} fetchpriority="high" />}
  <link rel="icon" href={favicon} />
  <style is:inline set:html={brandVars}></style>
  <script is:inline>document.documentElement.classList.add("js");</script>
  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
